# Database (Prisma 7 — connection URLs live here, not in schema.prisma)
DATABASE_URL=
DIRECT_DATABASE_URL=

# Auth (NextAuth)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI Providers — at least one must be fully configured for AI features to
# work. Fallback order (see lib/ai/providers/registry.ts): gemini, ollama,
# openai, anthropic, openrouter. Override with LLM_PROVIDER_ORDER below
# without a code change. Every provider needs BOTH its API key/host AND its
# model set to be considered configured.
# ---------------------------------------------------------------------------

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Local, free — requires Ollama running and reachable at OLLAMA_HOST.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional — comma-separated, overrides the default gemini,ollama,openai,anthropic,openrouter order.
# LLM_PROVIDER_ORDER=gemini,openai,anthropic

# ---------------------------------------------------------------------------
# Other integrations
# ---------------------------------------------------------------------------

# Keyword data provider (features/seo/services/keyword-provider.service.ts) — optional, required only for live keyword lookups.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Phase 24 — AES-256-GCM master key for encrypting PublishingConnection
# credentials at rest (lib/crypto/publishing-credential-crypto.ts). Required
# before any publishing connection can be created. Must be 32 random bytes,
# base64-encoded, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PUBLISHING_CREDENTIAL_ENCRYPTION_KEY=

# Optional — overrides where uploaded files are stored locally (defaults to ./storage/uploads).
LOCAL_STORAGE_DIR=

# ---------------------------------------------------------------------------
# Phase 9 — connecting a client's social accounts for real.
#
# Facebook is the first provider. Until BOTH values below are set, Settings →
# Clients → [client] → Social accounts says "Facebook connection is not
# configured yet" and offers no Connect action — it never pretends.
#
# Get these from a Meta app you own (developers.facebook.com). Two real-world
# limits to know before testing, neither of them a code problem:
#   - Meta's Standard Access only lets people WITH A ROLE ON YOUR APP complete
#     the flow. Reaching any client requires Advanced Access, which needs App
#     Review AND Business Verification.
#   - The redirect URI must be HTTPS and must match one registered with the
#     app EXACTLY.
# ---------------------------------------------------------------------------

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional — the public origin Cloud Compass is reachable at, used to build the
# OAuth redirect URI (<origin>/api/social/connect/facebook/callback). Defaults
# to NEXTAUTH_URL. Set this when they differ, e.g. a local HTTP origin behind a
# public HTTPS tunnel, since a provider generally will not register the former.
SOCIAL_OAUTH_REDIRECT_BASE_URL=
