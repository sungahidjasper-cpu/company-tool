// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// Coarse, JWT-embeddable access tier used for route-gating in proxy.ts.
/// Kept deliberately separate from the Role/Permission relation below,
/// which is for future fine-grained, per-feature authorization checks.
enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ClientStatus {
  LEAD
  ACTIVE
  INACTIVE
  CHURNED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

/// Shared by Task and Project — kept as one enum rather than a
/// near-duplicate ProjectPriority/TaskPriority pair.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SeoProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum KeywordIntent {
  INFORMATIONAL
  NAVIGATIONAL
  COMMERCIAL
  TRANSACTIONAL
}

enum KeywordStatus {
  NOT_STARTED
  IN_PROGRESS
  RANKING
  ACHIEVED
  ABANDONED
}

enum WebsiteAnalysisStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// Classifies why the AI stage of a WebsiteAnalysisJob failed, so the UI can
/// show a clear message + recommended action instead of a raw provider
/// error. Null for crawl-stage failures (those already have a clear,
/// hand-written message) and for SUCCEEDED/PENDING/RUNNING jobs.
enum WebsiteAnalysisErrorType {
  AUTHENTICATION_ERROR
  INSUFFICIENT_CREDITS
  RATE_LIMIT
  TIMEOUT
  SERVICE_UNAVAILABLE
  INVALID_REQUEST
  NOT_CONFIGURED
  UNKNOWN
  /// Phase 19 — this company's configured monthly AI spend cap has been
  /// reached. Distinct from RATE_LIMIT (which means the AI PROVIDER
  /// rate-limited us) and from INSUFFICIENT_CREDITS (the provider's own
  /// account is out of funds) — this is a limit WE impose on a tenant.
  BUDGET_EXCEEDED
  /// Phase 19 — this company's configured per-minute AI request rate limit
  /// has been reached. Distinct from RATE_LIMIT for the same reason above.
  COMPANY_RATE_LIMITED
  /// Phase 20 — the configured model for a provider was rejected as not
  /// found/no longer available (e.g. a deprecated model name). Unlike
  /// INVALID_REQUEST, this is fallback-worthy — a bad model name on one
  /// provider says nothing about whether another configured provider would
  /// also fail.
  MODEL_UNAVAILABLE
}

/// Phase 18 — status machine for AiGenerationJob, a new enum rather than a
/// reuse of WebsiteAnalysisStatus (same 4 values, but reusing a
/// WebsiteAnalysis-named enum for an unrelated job type is exactly the
/// misleading-name trap this schema already avoids elsewhere — see
/// WebsiteAnalysisIssueSeverity's comment). SUCCEEDED and FAILED are
/// terminal everywhere this enum is read — nothing transitions out of them.
/// Anticipated future addition: CANCELLED, once a Phase 22-style
/// cancellation feature ships. Deliberately not added yet — an enum value
/// nothing ever sets is dead schema a future reader has to puzzle out, and
/// adding it later is an equally cheap, additive migration when it's
/// actually needed.
enum AiGenerationJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ReportType {
  PROJECT_SUMMARY
  CLIENT_SUMMARY
  SEO_PERFORMANCE
  FINANCIAL
  SALES_PIPELINE
  CUSTOM
  /// Phase 13 — a complete SEO audit for one SEO Project, sourced entirely
  /// from that project's most recent SUCCEEDED WebsiteAnalysisJob (no new
  /// AI calls, no new crawling).
  SEO_AUDIT
}

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Tenancy & Identity
// ---------------------------------------------------------------------------

/// The tenant/workspace boundary. Every company-owned model below scopes
/// itself through this model, directly or by walking a parent relation —
/// none of them duplicate a companyId that can be reached that way.
model Company {
  id                   String    @id @default(uuid(7)) @db.Uuid
  name                 String
  slug                 String    @unique
  industry             String?
  website              String?
  logoUrl              String?
  timezone             String?
  /// Phase 19 — SUPER_ADMIN-only. Hard ceiling on this company's AI spend
  /// for the current UTC calendar month, summed from
  /// AiUsageLog.estimatedCostUsd (see lib/ai/ai-limit.service.ts). Null =
  /// no cap enforced — the default for every existing company and any
  /// company a SUPER_ADMIN hasn't explicitly configured. Never editable by
  /// a company's own ADMIN (see company-ai-limits.actions.ts).
  aiMonthlyBudgetUsd   Decimal?  @db.Decimal(10, 2)
  /// Phase 19 — SUPER_ADMIN-only. Ceiling on AI-triggering requests per
  /// rolling 60-second window, enforced in-memory
  /// (lib/ai/ai-limit.service.ts). Null = no limit enforced — same no-op
  /// default as above. Deliberately NOT a platform-wide default when
  /// null — that would change existing companies' behavior on rollout.
  aiRateLimitPerMinute Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  users               User[]
  roles               Role[]
  clients             Client[]
  leads               Lead[]
  projects            Project[]
  tags                Tag[]
  seoProjects         SEOProject[]
  reports             Report[]
  aiConversations     AIConversation[]
  files               File[]
  activities          Activity[]
  websiteAnalysisJobs WebsiteAnalysisJob[]
  aiGenerationJobs    AiGenerationJob[]
  aiUsageLogs         AiUsageLog[]

  @@index([deletedAt])
}

/// Global catalog of grantable capabilities (e.g. "projects:create").
/// Not company-scoped and not soft-deletable: permissions are a fixed,
/// system-managed vocabulary, not tenant data.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles Role[]
}

/// A named bundle of permissions. System roles (isSystem = true) have a
/// null companyId and are shared across every tenant (e.g. "Owner",
/// "Member"); custom roles belong to exactly one company.
model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String?   @db.Uuid
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]
  permissions Permission[]

  @@unique([companyId, name])
  @@index([deletedAt])
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  companyId       String     @db.Uuid
  email           String     @unique
  firstName       String
  lastName        String
  avatar          String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  role            UserRole   @default(EMPLOYEE)
  status          UserStatus @default(INVITED)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles   Role[]

  ownedClients            Client[]          @relation("ClientOwner")
  ownedProjects           Project[]         @relation("ProjectOwner")
  assignedProjects        Project[]         @relation("ProjectAssignees")
  assignedTasks           Task[]            @relation("TaskAssignee")
  createdTasks            Task[]            @relation("TaskCreatedBy")
  assignedLeads           Lead[]            @relation("LeadAssignee")
  createdLeads            Lead[]            @relation("LeadCreatedBy")
  assignedLeadTasks       LeadTask[]        @relation("LeadTaskAssignee")
  createdLeadTasks        LeadTask[]        @relation("LeadTaskCreatedBy")
  authoredNotes           Note[]            @relation("NoteAuthor")
  performedActivities     Activity[]        @relation("ActivityActor")
  targetedActivities      Activity[]        @relation("ActivityUser")
  uploadedFiles           File[]            @relation("FileUploadedBy")
  attachedFiles           File[]            @relation("FileUser")
  notifications           Notification[]
  ownedSeoProjects        SEOProject[]      @relation("SeoProjectOwner")
  ownedKeywords           Keyword[]         @relation("KeywordOwner")
  authoredContent         Content[]         @relation("ContentAuthor")
  aiConversations         AIConversation[]
  generatedReports        Report[]          @relation("ReportGeneratedBy")
  startedAiGenerationJobs AiGenerationJob[] @relation("AiGenerationJobCreatedBy")

  @@index([companyId, status])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Client {
  id        String       @id @default(uuid(7)) @db.Uuid
  companyId String       @db.Uuid
  ownerId   String?      @db.Uuid
  name      String
  email     String?
  industry  String?
  website   String?
  phone     String?
  address   String?
  status    ClientStatus @default(LEAD)
  source    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   User?   @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  contacts            Contact[]
  projects            Project[]
  leads               Lead[]
  seoProjects         SEOProject[]
  websiteAnalysisJobs WebsiteAnalysisJob[]
  notes               Note[]
  activities          Activity[]
  files               File[]
  reports             Report[]
  tags                Tag[]

  @@index([companyId, status])
  @@index([deletedAt])
}

model Contact {
  id        String    @id @default(uuid(7)) @db.Uuid
  clientId  String    @db.Uuid
  name      String
  email     String?
  phone     String?
  jobTitle  String?
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  notes      Note[]
  activities Activity[]
  files      File[]

  @@unique([clientId, email])
  @@index([deletedAt])
}

/// A prospective deal moving through the sales pipeline. `companyName` is
/// the prospect's own organization (distinct from `companyId`, the tenant
/// that owns this record) — named to avoid colliding with the `company`
/// relation every tenant-scoped model carries. Notes/activity/files reuse
/// the shared Note/Activity/File models via their `leadId` FK rather than
/// dedicated Lead-only tables, matching this schema's existing polymorphic-
/// attachment pattern (see the comment above Tag/Note/Activity/File).
model Lead {
  id             String     @id @default(uuid(7)) @db.Uuid
  companyId      String     @db.Uuid
  clientId       String?    @db.Uuid
  projectId      String?    @db.Uuid
  assignedUserId String?    @db.Uuid
  createdById    String?    @db.Uuid
  name           String
  companyName    String?
  email          String?
  phone          String?
  source         String?
  status         LeadStatus @default(NEW)
  value          Decimal?   @db.Decimal(12, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedUser User?    @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy    User?    @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  tasks      LeadTask[]
  notes      Note[]
  activities Activity[]
  files      File[]

  @@index([companyId, status])
  @@index([assignedUserId])
  @@index([clientId])
  @@index([projectId])
  @@index([deletedAt])
}

/// Mirrors Task's shape for a Lead's own to-dos. Kept as a dedicated model
/// rather than making the existing Task.projectId optional: Task is deeply
/// project-shaped (subtasks, project-nested routes, tags) and retrofitting
/// it to also hang off a Lead would risk the working Project/Task feature.
/// Reuses TaskStatus/Priority rather than near-duplicate Lead-only enums.
model LeadTask {
  id          String     @id @default(uuid(7)) @db.Uuid
  leadId      String     @db.Uuid
  assigneeId  String?    @db.Uuid
  createdById String?    @db.Uuid
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee  User? @relation("LeadTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User? @relation("LeadTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId, status])
  @@index([assigneeId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Projects & Tasks
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(uuid(7)) @db.Uuid
  companyId   String        @db.Uuid
  clientId    String?       @db.Uuid
  ownerId     String?       @db.Uuid
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  priority    Priority      @default(MEDIUM)
  startDate   DateTime?
  dueDate     DateTime?
  budget      Decimal?      @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  assignedUsers User[]     @relation("ProjectAssignees")
  tasks         Task[]
  leads         Lead[]
  notes         Note[]
  activities    Activity[]
  files         File[]
  reports       Report[]
  tags          Tag[]

  @@index([companyId, status])
  @@index([clientId])
  @@index([deletedAt])
}

model Task {
  id           String     @id @default(uuid(7)) @db.Uuid
  projectId    String     @db.Uuid
  parentTaskId String?    @db.Uuid
  assigneeId   String?    @db.Uuid
  createdById  String?    @db.Uuid
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  priority     Priority   @default(MEDIUM)
  dueDate      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[]  @relation("TaskSubtasks")
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  notes      Note[]
  activities Activity[]
  files      File[]
  tags       Tag[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Shared attachments (Tag / Note / Activity / File)
//
// Prisma has no native polymorphic relation, so Note/Activity/File each
// carry one nullable FK per attachable entity instead of a single loosely-
// typed (entityType, entityId) pair. That keeps every attachment a real,
// referentially-enforced Prisma relation at the cost of "exactly one of
// these six should be set" being an application-level, not database-level,
// invariant. Tag instead attaches via five independent implicit many-to-
// many relations, since a tag legitimately belongs to many entities.
// ---------------------------------------------------------------------------

model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @db.Uuid
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clients     Client[]
  projects    Project[]
  tasks       Task[]
  seoProjects SEOProject[]
  content     Content[]

  @@unique([companyId, name])
}

model Note {
  id           String    @id @default(uuid(7)) @db.Uuid
  authorId     String    @db.Uuid
  clientId     String?   @db.Uuid
  contactId    String?   @db.Uuid
  projectId    String?   @db.Uuid
  taskId       String?   @db.Uuid
  leadId       String?   @db.Uuid
  seoProjectId String?   @db.Uuid
  contentId    String?   @db.Uuid
  body         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  author     User        @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  seoProject SEOProject? @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  content    Content?    @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([contactId])
  @@index([projectId])
  @@index([taskId])
  @@index([leadId])
  @@index([seoProjectId])
  @@index([contentId])
}

/// An immutable audit-trail entry — intentionally has no deletedAt.
/// Enterprise activity logs must stay append-only for the trail to be
/// trustworthy; updatedAt is kept only because every model in this schema
/// carries one, and in practice it will always equal createdAt.
model Activity {
  id           String   @id @default(uuid(7)) @db.Uuid
  actorId      String?  @db.Uuid
  companyId    String?  @db.Uuid
  clientId     String?  @db.Uuid
  contactId    String?  @db.Uuid
  projectId    String?  @db.Uuid
  taskId       String?  @db.Uuid
  leadId       String?  @db.Uuid
  seoProjectId String?  @db.Uuid
  contentId    String?  @db.Uuid
  /// The user this activity concerns (e.g. "user created") — distinct
  /// from actorId, which is who performed the action.
  userId       String?  @db.Uuid
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actor      User?       @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  company    Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  seoProject SEOProject? @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  content    Content?    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user       User?       @relation("ActivityUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([clientId])
  @@index([contactId])
  @@index([projectId])
  @@index([taskId])
  @@index([leadId])
  @@index([seoProjectId])
  @@index([contentId])
  @@index([userId])
}

model File {
  id           String    @id @default(uuid(7)) @db.Uuid
  uploadedById String    @db.Uuid
  companyId    String?   @db.Uuid
  clientId     String?   @db.Uuid
  contactId    String?   @db.Uuid
  projectId    String?   @db.Uuid
  taskId       String?   @db.Uuid
  leadId       String?   @db.Uuid
  seoProjectId String?   @db.Uuid
  contentId    String?   @db.Uuid
  userId       String?   @db.Uuid
  fileName     String
  url          String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  uploadedBy User        @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  company    Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  seoProject SEOProject? @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  content    Content?    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  /// The user this file is attached to (e.g. an HR document) — distinct
  /// from uploadedBy, which is who performed the upload.
  user       User?       @relation("FileUser", fields: [userId], references: [id], onDelete: Cascade)
  report     Report?

  @@index([companyId])
  @@index([clientId])
  @@index([contactId])
  @@index([projectId])
  @@index([taskId])
  @@index([leadId])
  @@index([seoProjectId])
  @@index([contentId])
  @@index([userId])
  @@index([deletedAt])
}

enum NotificationType {
  TASK_ASSIGNED
  COMMENT_MENTION
  DUE_DATE_REMINDER
  PROJECT_UPDATE
  FILE_UPLOADED
  LEAD_ASSIGNED
  LEAD_MOVED
  LEAD_WON
  LEAD_LOST
}

/// Always personal — userId is the recipient. Due-date reminders are
/// computed on read (no cron infrastructure exists), not stored here;
/// every other type is a real row created inline by the action that
/// triggered it.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// SEO Workspace
// ---------------------------------------------------------------------------

model SEOProject {
  id        String           @id @default(uuid(7)) @db.Uuid
  companyId String           @db.Uuid
  clientId  String?          @db.Uuid
  ownerId   String?          @db.Uuid
  name      String
  domain    String
  status    SeoProjectStatus @default(ACTIVE)
  startDate DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner   User?   @relation("SeoProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  keywordClusters     KeywordCluster[]
  keywords            Keyword[]
  content             Content[]
  notes               Note[]
  activities          Activity[]
  files               File[]
  reports             Report[]
  tags                Tag[]
  websiteAnalysisJobs WebsiteAnalysisJob[]
  aiUsageLogs         AiUsageLog[]
  aiGenerationJobs    AiGenerationJob[]

  @@index([companyId, status])
  @@index([clientId])
  @@index([deletedAt])
}

model KeywordCluster {
  id           String    @id @default(uuid(7)) @db.Uuid
  seoProjectId String    @db.Uuid
  name         String
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  seoProject SEOProject @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  keywords   Keyword[]

  @@index([seoProjectId])
  @@index([deletedAt])
}

model Keyword {
  id           String         @id @default(uuid(7)) @db.Uuid
  seoProjectId String         @db.Uuid
  clusterId    String?        @db.Uuid
  ownerId      String?        @db.Uuid
  term         String
  searchVolume Int?
  difficulty   Int?
  currentRank  Int?
  targetUrl    String?
  intent       KeywordIntent?
  priority     Priority       @default(MEDIUM)
  status       KeywordStatus  @default(NOT_STARTED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  seoProject SEOProject      @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  cluster    KeywordCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  owner      User?           @relation("KeywordOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  content    Content[]

  @@unique([seoProjectId, term])
  @@index([clusterId])
  @@index([ownerId])
  @@index([deletedAt])
}

model Content {
  id              String        @id @default(uuid(7)) @db.Uuid
  seoProjectId    String        @db.Uuid
  authorId        String?       @db.Uuid
  title           String
  url             String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  /// Phase 15 — populated only for AI-generated content briefs; null for
  /// every pre-existing/manually-authored row.
  metaTitle       String?
  metaDescription String?
  /// Phase 15 — consolidated JSON for the rest of an AI-generated brief
  /// (outline, suggested headings, internal-link suggestions, SEO
  /// recommendations, GEO/AEO notes, content type, suggested search
  /// intent). Display-only fields with no query/filter need yet, so one
  /// JSON column instead of one column per field.
  aiBriefDetails  Json?
  /// Phase 15 — provenance flag; does not affect the existing
  /// SEO_PERFORMANCE report, which only ever counts by `status`.
  generatedByAi   Boolean       @default(false)
  /// Phase 16 — the long-form article body, stored as plain Markdown text
  /// (not JSON, not HTML) so it needs no rich-text/WYSIWYG dependency and
  /// fits the app's existing plain-textarea editing convention exactly.
  /// Null for every brief-only Content row and every pre-Phase-16 row.
  body            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  seoProject SEOProject @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  author     User?      @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  keywords   Keyword[]

  notes            Note[]
  activities       Activity[]
  files            File[]
  tags             Tag[]
  aiGenerationJobs AiGenerationJob[]

  @@index([seoProjectId, status])
  @@index([deletedAt])
}

/// Backs the automated website-analysis crawl (Phase 10.5a). Nullable
/// seoProjectId because analysis can run before the SEOProject formally
/// exists (the future wizard analyzes a domain before creating the project).
/// resultJson stores the crawl + LLM extraction output as JSON rather than a
/// normalized model, following the same precedent AIConversation.context set.
model WebsiteAnalysisJob {
  id              String                    @id @default(uuid(7)) @db.Uuid
  seoProjectId    String?                   @db.Uuid
  /// Direct client link, independent of seoProjectId (same "shared
  /// attachment" pattern as Report.clientId) — lets analyses be filtered/
  /// grouped by client even when no SEOProject has been created yet.
  clientId        String?                   @db.Uuid
  companyId       String                    @db.Uuid
  domain          String
  status          WebsiteAnalysisStatus     @default(PENDING)
  progress        Int?
  overallScore    Int?
  resultJson      Json?
  /// Raw crawl output, persisted as soon as crawling succeeds — independent
  /// of whether the later AI stage succeeds. Lets a failed AI stage be
  /// retried without re-crawling (crawling takes 30-120s+).
  crawlResultJson Json?
  errorMessage    String?
  /// Set only when the AI stage failed after a successful crawl; null for
  /// crawl-stage failures and non-failed jobs.
  errorType       WebsiteAnalysisErrorType?
  /// Phase 11C — SHA-256 of the canonicalized crawlResultJson, computed once
  /// crawling succeeds. Lets a later analysis of the same domain skip
  /// AI regeneration when both this hash and the prompt version match a
  /// prior SUCCEEDED job exactly (see seo-audit.service.ts PROMPT_VERSION).
  crawlHash       String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  seoProject SEOProject? @relation(fields: [seoProjectId], references: [id], onDelete: SetNull)
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  issues      WebsiteAnalysisIssue[]
  aiUsageLogs AiUsageLog[]

  @@index([companyId])
  @@index([seoProjectId])
  @@index([clientId])
  @@index([status])
  @@index([domain, crawlHash])
}

/// Phase 11B — itemized, per-URL technical findings, replacing/extending the
/// old aggregate-only findings that seo-scoring.service.ts produces. A real
/// relational model (not JSON) because `status` needs independent mutation
/// per issue across future re-analyses, which a JSON blob can't do well.
enum WebsiteAnalysisIssueType {
  MISSING_TITLE
  MISSING_META_DESCRIPTION
  DUPLICATE_TITLE
  DUPLICATE_H1
  BROKEN_LINK
  REDIRECT_CHAIN
  LARGE_IMAGE
  MISSING_ALT_TEXT
  CANONICAL_ISSUE
  SITEMAP_ISSUE
  ROBOTS_ISSUE
  STRUCTURED_DATA_ISSUE
  INTERNAL_LINKING_OPPORTUNITY
  /// Phase 11C
  MISSING_OG_TAGS
  MISSING_TWITTER_CARD
}

enum WebsiteAnalysisIssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  IGNORED
}

/// Deliberately NOT the global Priority enum (LOW/MEDIUM/HIGH/URGENT, used
/// by Task/Project) — the SEO feature already has its own CRITICAL/HIGH/
/// MEDIUM/LOW scale (seo-scoring.service.ts's `PRIORITIES`, used by
/// DeterministicFinding/Recommendation), and this keeps severity consistent
/// with that, not the CRM's unrelated scale.
enum WebsiteAnalysisIssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model WebsiteAnalysisIssue {
  id                   String                       @id @default(uuid(7)) @db.Uuid
  websiteAnalysisJobId String                       @db.Uuid
  issueType            WebsiteAnalysisIssueType
  severity             WebsiteAnalysisIssueSeverity
  /// Null for site-wide issues (e.g. sitemap/robots) that aren't tied to one URL.
  url                  String?
  explanation          String
  recommendedFix       String
  status               WebsiteAnalysisIssueStatus   @default(OPEN)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  websiteAnalysisJob WebsiteAnalysisJob @relation(fields: [websiteAnalysisJobId], references: [id], onDelete: Cascade)

  @@index([websiteAnalysisJobId])
  @@index([issueType])
  @@index([status])
}

/// Phase 11C — the 5 independent AI calls the website-analysis pipeline
/// makes (extraction, then the 3-way audit split, then the executive
/// summary that depends on 2 of those). Matches the task boundaries already
/// established in seo-audit.service.ts / website-analysis.service.ts, not a
/// new decomposition.
enum AiTaskType {
  EXTRACTION
  SCORES
  RECOMMENDATIONS
  CONTENT_INTELLIGENCE
  EXECUTIVE_SUMMARY
  /// Phase 15 — AI SEO Content Brief Generator. Scoped via
  /// AiUsageLog.seoProjectId rather than websiteAnalysisJobId (see below).
  CONTENT_BRIEF
  /// Phase 16 — AI Long-Form SEO Content Generator. Generates the article
  /// body from an already-approved CONTENT_BRIEF; also scoped via
  /// AiUsageLog.seoProjectId, never websiteAnalysisJobId.
  CONTENT_DRAFT
}

/// Phase 11C — one row per provider attempt (success or failure), for cost/
/// usage analytics and provider health/retry visibility. Deliberately a real
/// table, not JSON on WebsiteAnalysisJob, since it's queried in aggregate
/// across jobs/providers/time, not read alongside any single job.
/// websiteAnalysisJobId is optional (SetNull) so this analytics history
/// outlives any one job's lifecycle. errorType reuses the existing
/// WebsiteAnalysisErrorType enum rather than duplicating the same 8 values.
model AiUsageLog {
  id                   String                    @id @default(uuid(7)) @db.Uuid
  websiteAnalysisJobId String?                   @db.Uuid
  /// Phase 15 — the company-scoping path for AI calls that aren't tied to a
  /// WebsiteAnalysisJob (e.g. CONTENT_BRIEF). Optional/SetNull, mirroring
  /// websiteAnalysisJobId exactly. A row should have at least one of the two
  /// set so it remains reachable by a company-scoped query; enforced by the
  /// calling code, not a DB constraint (same convention as the rest of this
  /// schema).
  seoProjectId         String?                   @db.Uuid
  /// Phase 19 — direct company scoping, added alongside the existing
  /// websiteAnalysisJobId/seoProjectId relations (not replacing them).
  /// Nullable for backward compat; historical rows are intentionally not
  /// backfilled (the budget check only ever looks at the current month, so
  /// no pre-Phase-19 row can ever fall inside a period that starts after
  /// this shipped). Populated on every new row going forward, since
  /// generateStructuredOutput's companyId input is now required. Exists so
  /// the budget-check query is a single indexed WHERE instead of the
  /// two-way LEFT JOIN ai-usage.service.ts's dashboard queries need today.
  companyId            String?                   @db.Uuid
  provider             String
  taskType             AiTaskType
  promptVersion        Int
  model                String?
  temperature          Float?
  promptTokens         Int?
  completionTokens     Int?
  estimatedCostUsd     Decimal?                  @db.Decimal(10, 6)
  succeeded            Boolean
  errorType            WebsiteAnalysisErrorType?
  latencyMs            Int
  retried              Boolean                   @default(false)
  createdAt            DateTime                  @default(now())

  websiteAnalysisJob WebsiteAnalysisJob? @relation(fields: [websiteAnalysisJobId], references: [id], onDelete: SetNull)
  seoProject         SEOProject?         @relation(fields: [seoProjectId], references: [id], onDelete: SetNull)
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([websiteAnalysisJobId])
  @@index([seoProjectId])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([provider])
  @@index([taskType])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// AI Workspace & Reporting
// ---------------------------------------------------------------------------

/// Phase 18 — background job row backing Content Brief (CONTENT_BRIEF) and
/// Long-Form (CONTENT_DRAFT) generation, replacing the fully-synchronous
/// generate actions those features used through Phase 17. Mirrors
/// WebsiteAnalysisJob's proven pattern (status/progress/error fields, a
/// job-table.ts-style helper module, fire-and-forget kickoff, polling
/// action, startup reaper) but is generic across task types via
/// inputJson/resultJson JSON columns instead of crawl-specific columns, so
/// one table serves both task types today and any future generation task
/// type without a new migration. Deliberately NOT an extension of
/// WebsiteAnalysisJob itself — its crawl-specific fields (domain,
/// crawlResultJson, crawlHash, overallScore) don't apply here, and reusing
/// it would mix unrelated concerns into one polymorphic table.
model AiGenerationJob {
  id           String                    @id @default(uuid(7)) @db.Uuid
  companyId    String                    @db.Uuid
  /// Denormalized alongside seoProject's own companyId, same accepted
  /// convention WebsiteAnalysisJob already uses — lets every query scope
  /// directly without an extra join.
  seoProjectId String?                   @db.Uuid
  /// Set for the already-saved-brief long-form flow (the job IS about this
  /// row); null for a fresh-flow job, where no Content row exists yet.
  contentId    String?                   @db.Uuid
  /// Reuses the existing enum as-is — CONTENT_BRIEF | CONTENT_DRAFT today,
  /// extensible to a future generation task type with no new migration.
  taskType     AiTaskType
  status       AiGenerationJobStatus     @default(PENDING)
  progress     Int?
  /// The exact validated input the job was started with — the runner reads
  /// this back to actually perform the generation. Shape depends on
  /// taskType; validated with the existing zod schemas at both write time
  /// and read time, never trusted as already-safe just because it's in the
  /// database.
  inputJson    Json
  /// SHA-256 of the canonicalized inputJson, same technique
  /// WebsiteAnalysisJob.crawlHash already uses applied to a different
  /// problem: lets a duplicate "Generate" click (a double-click, or a page
  /// refresh followed by clicking again while the first job is still in
  /// flight) reuse the existing PENDING/RUNNING job for the identical
  /// request instead of starting a second, separately-billed AI call.
  inputHash    String
  /// The generated candidate (ContentBriefOutput | LongFormContentOutput)
  /// once SUCCEEDED — the UI polls this to populate the review screen.
  resultJson   Json?
  errorMessage String?
  /// Reuses the existing enum — the identical taxonomy already used by
  /// WebsiteAnalysisJob and AiUsageLog, no new error vocabulary needed.
  errorType    WebsiteAnalysisErrorType?
  /// Who started it — WebsiteAnalysisJob doesn't track this (company-wide
  /// visibility was sufficient for an SEO-project-level utility), but a
  /// content draft is a more personal, actively-being-edited session, so
  /// this is one deliberate, small addition beyond the source pattern.
  createdById  String?                   @db.Uuid
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seoProject SEOProject? @relation(fields: [seoProjectId], references: [id], onDelete: SetNull)
  content    Content?    @relation(fields: [contentId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("AiGenerationJobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([seoProjectId])
  @@index([contentId])
  @@index([status])
  @@index([createdById])
  @@index([companyId, taskType, inputHash, status])
}

/// Messages are stored as a JSON transcript rather than a normalized
/// AIMessage model, since AIMessage was not part of the requested model
/// list. If per-message querying becomes a requirement, extracting a real
/// child model is the natural next migration.
model AIConversation {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @db.Uuid
  userId    String    @db.Uuid
  title     String?
  model     String?
  context   Json?
  messages  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([deletedAt])
}

model Report {
  id            String       @id @default(uuid(7)) @db.Uuid
  companyId     String       @db.Uuid
  generatedById String?      @db.Uuid
  clientId      String?      @db.Uuid
  projectId     String?      @db.Uuid
  seoProjectId  String?      @db.Uuid
  fileId        String?      @unique @db.Uuid
  title         String
  type          ReportType   @default(CUSTOM)
  status        ReportStatus @default(PENDING)
  parameters    Json?
  generatedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedBy User?       @relation("ReportGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  seoProject  SEOProject? @relation(fields: [seoProjectId], references: [id], onDelete: SetNull)
  file        File?       @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([clientId])
  @@index([projectId])
  @@index([seoProjectId])
  @@index([deletedAt])
}
